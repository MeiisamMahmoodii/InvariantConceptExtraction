\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Exact feature-decomposition metrics and the matched-versus-InfoNCE comparison. Selectivity values are standardized feature-level scores. Active features are identified on seen-language training rows; active-feature stability is their mean activation correlation over aligned held-out Arabic--Chinese IDs. The InfoNCE $z_C$ value is the frozen-checkpoint recomputation used for the paired bootstrap.}}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:concept-quality}{{2}{7}{Exact feature-decomposition metrics and the matched-versus-InfoNCE comparison. Selectivity values are standardized feature-level scores. Active features are identified on seen-language training rows; active-feature stability is their mean activation correlation over aligned held-out Arabic--Chinese IDs. The InfoNCE $z_C$ value is the frozen-checkpoint recomputation used for the paired bootstrap}{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Breadth and statistical consistency of preserved-factor feature quality. Active features and intent-specific features are selected on seen languages only. (A) Aggregate held-out Arabic--Chinese active-feature stability. Higher stability is desired for the preserved-dominant $z_C$ route, whereas low stability is expected for $z_S$ because locale is its varying factor. (B) Per-semantic-ID matched-minus-InfoNCE $z_C$ stability differences. (C) Paired held-out concept AUC for raw $H$ and matched $z_C$ across 58 intents.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:quantitative-evidence}{{3}{7}{Breadth and statistical consistency of preserved-factor feature quality. Active features and intent-specific features are selected on seen languages only. (A) Aggregate held-out Arabic--Chinese active-feature stability. Higher stability is desired for the preserved-dominant $z_C$ route, whereas low stability is expected for $z_S$ because locale is its varying factor. (B) Per-semantic-ID matched-minus-InfoNCE $z_C$ stability differences. (C) Paired held-out concept AUC for raw $H$ and matched $z_C$ across 58 intents}{figure.caption.12}{}}
